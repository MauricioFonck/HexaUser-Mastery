{
    "name": "mauriciofonck/hexa-user-mastery",
    "description": "User CRUD with Hexagonal Architecture and DDD",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "classmap": [
            "src/Common/",
            "src/Domain/",
            "src/Application/",
            "src/Infrastructure/"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
